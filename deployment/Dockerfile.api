# Dockerfile for VPR FastAPI Gateway
#
# Build context: project root (d:/UIT/Research/VPR-OT/salad)
# Usage:
#   docker build -f deployment/Dockerfile.api -t vpr-api .

FROM python:3.10-slim

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first (better layer caching)
COPY api/requirements.txt ./requirements_api.txt
RUN pip install --no-cache-dir -r requirements_api.txt

# Copy API source
COPY api/ ./api/

# Create data directory for FAISS index
RUN mkdir -p /app/data

# Non-root user for security
RUN useradd -m -u 1000 vpruser && chown -R vpruser:vpruser /app
USER vpruser

EXPOSE 8080

# Start FastAPI with uvicorn
CMD ["uvicorn", "api.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8080", \
     "--workers", "2", \
     "--log-level", "info"]
